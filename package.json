{
  "name": "chowa",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "play": "npm run build && npm run preview -- --open",
    "test": "vitest run",
    "levels": "tsx scripts/generateLevels.ts",
    "icons": "tsx scripts/makeIcons.ts",
    "app": "tsc --noEmit && vite build --mode app && cap sync ios",
    "app:open": "npm run app && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/quicksand": "^5.1.0",
    "gsap": "^3.12.5",
    "pixi-filters": "^6.0.4",
    "pixi.js": "^8.5.2",
    "tone": "^15.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^20.19.43",
    "happy-dom": "^20.14.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
